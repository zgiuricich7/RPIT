# Copy to .env and adjust as needed.
PORT=3001
# SQLite (default): the database file.
# DATABASE_PATH=./server/data/rpit.db
# Or Postgres: a server URL, or "pglite:<folder>" for embedded Postgres without a server.
# DATABASE_URL=postgres://rpit:secret@localhost:5432/rpit
# Attachment files; defaults to an "uploads" folder next to the database.
# UPLOADS_DIR=./server/data/uploads
SESSION_DAYS=30
# NODE_ENV=production
